<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.momentum.bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/mlgubolin/dev/momentum/bot/.venv/bin/python</string>
        <string>/Users/mlgubolin/dev/momentum/bot/bot.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mlgubolin/dev/momentum/bot</string>

    <!-- whisper-cli and ffmpeg live in /opt/homebrew/bin -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/mlgubolin/Library/Logs/momentum-bot.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/mlgubolin/Library/Logs/momentum-bot.err.log</string>
</dict>
</plist>
