# Required — create a bot with @BotFather (https://t.me/BotFather) and paste the token.
TELEGRAM_BOT_TOKEN=

# Optional — path to the whisper.cpp CLI binary (default: whisper-cli on PATH).
# Install with: brew install whisper-cpp
# WHISPER_CPP_BIN=/opt/homebrew/bin/whisper-cli

# Optional — ggml model file. Relative paths are resolved against the bot/ dir.
# Download with: ./download-model.sh  (defaults to large-v3-turbo)
WHISPER_CPP_MODEL=models/ggml-large-v3-turbo.bin

# Optional — transcription language (ISO-639-1, or "auto"). Default pt.
WHISPER_LANGUAGE=pt

# Optional — compute threads passed to whisper-cli (-t). Empty = whisper.cpp default (4).
# WHISPER_CPP_THREADS=4

# Optional — where downloaded audio is staged before transcription.
# Defaults to the system temp dir (e.g. /tmp/momentum-bot on macOS).
# BOT_TMP_DIR=/tmp/momentum-bot

# Optional — path to an ffmpeg binary used to decode audio to WAV.
# Defaults to `ffmpeg` on PATH. The repo also ships one at app/bin/ffmpeg.
# FFMPEG_BIN=/Users/you/dev/momentum/app/bin/ffmpeg
